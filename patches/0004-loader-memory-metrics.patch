+
+    /// Samples belong only to successfully started, named workers in this namespace.
+    /// This does not poll startup futures, hold stubs, or run code in the target isolates.
+    pub(crate) fn memory_usage(&self) -> Vec<ffi::LoaderMemorySample> {
+        self.isolates
+            .borrow()
+            .iter()
+            .filter_map(|(id, stub)| {
+                let Some(Ok(service)) = stub.startup.peek() else {
+                    return None;
+                };
+                let bytes = service.sampled_memory_bytes();
+                (!stub.unlinked.get() && bytes != 0).then(|| ffi::LoaderMemorySample {
+                    id: id.clone(),
+                    bytes,
+                })
+            })
+            .collect()
+    }
 }
 
