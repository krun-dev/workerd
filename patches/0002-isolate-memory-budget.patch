+inline kj::Exception memoryBudgetException() {
+  auto e = KJ_EXCEPTION(OVERLOADED, "Worker exceeded experimental memory budget; worker stopped");
+  e.setDetail(MEMORY_LIMIT_DETAIL_ID, kj::heapArray<kj::byte>(0));
+  return e;
+}
+
+// One generation's budget. All state belongs to the event-loop thread except `stopped`
+// and the watchdog cancellation flag. Retiring forbids new work; stopped forbids all JS.
+class ExperimentalMemoryBudget final: public kj::Refcounted {
+ public:
+  struct Entry {
+    virtual void release() = 0;
+    kj::ListLink<Entry> link;
+    bool linked = false;
+  };
+  explicit ExperimentalMemoryBudget(kj::StringPtr name): name(kj::str(name)) {
+    auto value = std::getenv("WORKERD_EXPERIMENTAL_MEMORY_MB");
+    if (value != nullptr) {
+      char* end;
+      auto mb = std::strtoull(value, &end, 10);
+      KJ_REQUIRE(*value != '\0' && *end == '\0' && (mb == 0 || (mb >= 16 && mb <= 2048)),
+          "WORKERD_EXPERIMENTAL_MEMORY_MB must be 0 or 16..2048");
+      limit = mb * 1024 * 1024;
+    }
+    if (enabled()) {
+      if (auto value = std::getenv("WORKERD_EXPERIMENTAL_MEMORY_DRAIN_MS")) {
+        char* end;
+        graceMs = std::strtoull(value, &end, 10);
+        KJ_REQUIRE(*value != '\0' && *end == '\0' && graceMs <= 60000,
+            "WORKERD_EXPERIMENTAL_MEMORY_DRAIN_MS must be 0..60000");
+      }
+    }
+    auto retired = kj::newPromiseAndFulfiller<void>();
+    retiredPromise = retired.promise.fork();
+    retiredFulfiller = kj::mv(retired.fulfiller);
+    auto stopped = kj::newPromiseAndFulfiller<void>();
+    stoppedPromise = stopped.promise.fork();
+    stoppedFulfiller = kj::mv(stopped.fulfiller);
+    auto idle = kj::newPromiseAndFulfiller<void>();
+    idlePromise = idle.promise.fork();
+    idleFulfiller = kj::mv(idle.fulfiller);
+  }
+  ~ExperimentalMemoryBudget() noexcept(false) {
+    disarmWatchdog();
+  }
+
+  bool enabled() const {
+    return limit != 0;
+  }
+  bool exceeded() const {
+    return stopped.load();
+  }
+  bool isRetiring() const {
+    return retiring;
+  }
+  void startServing() {
+    serving = true;
+  }
+  size_t getLimit() const {
+    return limit;
+  }
+  kj::Promise<void> onRetired() {
+    return retiredPromise.addBranch();
+  }
+  kj::Promise<void> onStopped() {
+    return stoppedPromise.addBranch();
+  }
+  kj::Promise<void> onIdle() {
+    return idlePromise.addBranch();
+  }
+  kj::Duration remainingGrace() const {
+    auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(
+        deadline - std::chrono::steady_clock::now())
+                         .count();
+    return kj::max(int64_t(0), remaining) * kj::MILLISECONDS;
+  }
+
+  void add(Entry& e) {
+    entries.add(e);
+    e.linked = true;
+  }
+  void remove(Entry& e) {
+    if (e.linked) {
+      entries.remove(e);
+      e.linked = false;
+    }
+  }
+  void beginRequest() {
+    ++requests;
+  }
+  void endRequest() {
+    --requests;
+    notifyIdle();
+  }
+  // Connections do not necessarily retain the request promise. Conservatively allow the full
+  // grace period for a generation that has accepted one, then use upstream revocation.
+  void hasConnection() {
+    connectionSeen = true;
+  }
+  void revokeAll() {
+    disarmWatchdog();
+    stopped.store(true);
+    publish();
+    canceler.cancel(memoryBudgetException());
+    while (!entries.empty()) {
+      auto& e = entries.front();
+      remove(e);
+      e.release();
+    }
+  }
+  kj::Canceler canceler;
+
+  void configure(v8::Isolate::CreateParams& params) {
+    if (enabled()) params.constraints.ConfigureDefaultsFromHeapSize(0, limit + HEADROOM);
+  }
+  void install(v8::Isolate* isolate) {
+    if (!enabled()) return;
+    this->isolate = isolate;
+    isolate->AddNearHeapLimitCallback(nearLimit, this);
+    isolate->AddGCEpilogueCallback(afterGc, this);
+  }
+  void check(v8::Isolate* isolate, bool terminate = false) {
+    if (!enabled()) return;
+    v8::HeapStatistics stats;
+    isolate->GetHeapStatistics(&stats);
+    // Registered external memory includes ArrayBuffer backing stores, not all native memory.
+    auto used = stats.used_heap_size() + stats.external_memory();
+    if (used > limit) retire();
+    if (used > limit + HEADROOM) stopped.store(true);
+    if (exceeded() && terminate) isolate->TerminateExecution();
+  }
+
+  // KJ notifications are only published after V8 execution, never inside a GC callback.
+  void publish() {
+    if (retiring && !retiredPublished) {
+      retiredPublished = true;
+      KJ_LOG(WARNING, "experimental memory limit: retiring worker", name, limit, graceMs);
+      retiredFulfiller->fulfill();
+      notifyIdle();
+    }
+    if (exceeded() && !stoppedPublished) {
+      stoppedPublished = true;
+      KJ_LOG(WARNING, "experimental memory limit: stopping worker", name, limit);
+      stoppedFulfiller->reject(memoryBudgetException());
+    }
+  }
+  void beforeResponse() {
+    if (isolate != nullptr && v8::Isolate::GetCurrent() == isolate) check(isolate);
+  }
+  void disarmWatchdog() {
+    {
+      std::lock_guard lock(watchdogMutex);
+      watchdogCanceled = true;
+    }
+    watchdogChanged.notify_one();
+    watchdog = nullptr;  // Join before any path can destroy the V8 isolate.
+  }
+  void disposed() {
+    isolate = nullptr;
+    if (retiring) KJ_LOG(WARNING, "experimental memory limit: isolate disposed", name);
+  }
+
+ private:
+  void notifyIdle() {
+    if (retiredPublished && requests == 0 && !connectionSeen && !idlePublished) {
+      idlePublished = true;
+      idleFulfiller->fulfill();
+    }
+  }
+  void retire() {
+    if (retiring) return;
+    retiring = true;
+    deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(graceMs);
+    if (!serving || graceMs == 0) {
+      stopped.store(true);
+      return;
+    }
+    // Only retired generations need a thread. A KJ timer alone cannot interrupt synchronous
+    // JS that blocks the event loop. This thread performs no KJ promise operations or logging.
+    watchdog = kj::heap<kj::Thread>([this]() {
+      std::unique_lock lock(watchdogMutex);
+      if (!watchdogChanged.wait_until(lock, deadline, [this]() { return watchdogCanceled; })) {
+        stopped.store(true);
+        isolate->TerminateExecution();
+      }
+    });
+  }
+  static void afterGc(v8::Isolate* isolate, v8::GCType, v8::GCCallbackFlags, void* data) {
+    static_cast<ExperimentalMemoryBudget*>(data)->check(isolate, true);
+  }
+  static size_t nearLimit(void* data, size_t current, size_t) {
+    auto& self = *static_cast<ExperimentalMemoryBudget*>(data);
+    self.retire();
+    self.stopped.store(true);
+    v8::Isolate::GetCurrent()->TerminateExecution();
+    return current + HEADROOM;
+  }
+
+  static constexpr size_t HEADROOM = 16 * 1024 * 1024;
+  kj::List<Entry, &Entry::link> entries;
+  kj::String name;
+  v8::Isolate* isolate = nullptr;
+  size_t limit = 0;
+  uint64_t graceMs = 5000;
+  uint requests = 0;
+  bool serving = false;
+  bool retiring = false;
+  bool connectionSeen = false;
+  bool retiredPublished = false;
+  bool stoppedPublished = false;
+  bool idlePublished = false;
+  std::atomic<bool> stopped{false};
+  std::chrono::steady_clock::time_point deadline;
+  std::mutex watchdogMutex;
+  std::condition_variable watchdogChanged;
+  bool watchdogCanceled = false;
+  kj::Own<kj::Thread> watchdog;
+  kj::ForkedPromise<void> retiredPromise = nullptr;
+  kj::Own<kj::PromiseFulfiller<void>> retiredFulfiller;
+  kj::ForkedPromise<void> stoppedPromise = nullptr;
+  kj::Own<kj::PromiseFulfiller<void>> stoppedFulfiller;
+  kj::ForkedPromise<void> idlePromise = nullptr;
+  kj::Own<kj::PromiseFulfiller<void>> idleFulfiller;
+};
+
+// Startup/import have their own error channel; report memory termination before the caller
+// tries to turn a terminated V8 TryCatch into a JavaScript exception.
+class MemoryStartupScope {
+ public:
+  MemoryStartupScope(ExperimentalMemoryBudget& budget,
+      jsg::Lock& lock,
+      kj::OneOf<kj::Exception, kj::Duration>& result,
+      kj::Own<void> inner)
+      : budget(budget),
+        isolate(lock.v8Isolate),
+        result(result),
+        inner(kj::mv(inner)) {}
+  ~MemoryStartupScope() noexcept(false) {
+    inner = nullptr;
+    budget.check(isolate);
+    budget.publish();
+    if (budget.exceeded()) result = memoryBudgetException();
+  }
+
+ private:
+  ExperimentalMemoryBudget& budget;
+  v8::Isolate* isolate;
+  kj::OneOf<kj::Exception, kj::Duration>& result;
+  kj::Own<void> inner;
+};
+
+// Own and revoke the entrypoint, not just the promise returned by fetch(). In particular, an
+// uninvoked entrypoint must not pin an IoContext and its isolate after the worker is stopped.
+class MemoryLimitedWorkerInterface final: public WorkerInterface,
+                                          private ExperimentalMemoryBudget::Entry {
+ public:
+  MemoryLimitedWorkerInterface(kj::Own<WorkerInterface> inner,
+      kj::Own<ExperimentalMemoryBudget> budget,
+      const kj::HttpHeaderTable& headerTable)
+      : budget(kj::mv(budget)),
+        inner(kj::mv(inner)),
+        headerTable(headerTable) {
+    this->budget->add(*this);
+  }
+  ~MemoryLimitedWorkerInterface() noexcept(false) {
+    budget->remove(*this);
+  }
+  void release() override {
+    inner = nullptr;
+  }
+
+  kj::Promise<void> request(kj::HttpMethod method,
+      kj::StringPtr url,
+      const kj::HttpHeaders& headers,
+      kj::AsyncInputStream& body,
+      Response& response) override {
+    budget->beginRequest();
+    KJ_DEFER(budget->endRequest());
+    ResponseTracker tracker(response, *budget);
+    KJ_TRY {
+      requireLive();
+      co_await budget->canceler.wrap(inner->request(method, url, headers, body, tracker));
+    }
+    KJ_CATCH(e) {
+      if (!budget->exceeded() || tracker.sent) kj::throwFatalException(kj::mv(e));
+      constexpr kj::StringPtr message = "Worker stopped: memory limit exceeded.\n"_kj;
+      kj::HttpHeaders out(headerTable);
+      out.setPtr(kj::HttpHeaderId::CONTENT_TYPE, "text/plain; charset=utf-8");
+      auto stream = response.send(503, "Service Unavailable", out, message.size());
+      co_await stream->write(message.asBytes());
+    }
+  }
+
+  kj::Promise<void> connect(kj::StringPtr host,
+      const kj::HttpHeaders& headers,
+      kj::AsyncIoStream& connection,
+      ConnectResponse& response,
+      kj::HttpConnectSettings settings) override {
+    requireLive();
+    budget->hasConnection();
+    return budget->canceler.wrap(
+        inner->connect(host, headers, connection, response, kj::mv(settings)));
+  }
+  kj::Promise<void> prewarm(kj::StringPtr url) override {
+    requireLive();
+    return track(inner->prewarm(url));
+  }
+  kj::Promise<ScheduledResult> runScheduled(kj::Date time, kj::StringPtr cron) override {
+    requireLive();
+    return track(inner->runScheduled(time, cron));
+  }
+  kj::Promise<AlarmResult> runAlarm(kj::Date time, uint32_t retries) override {
+    requireLive();
+    return track(inner->runAlarm(time, retries));
+  }
+  kj::Promise<kj::Maybe<kj::Date>> abandonAlarm(kj::Date time) override {
+    requireLive();
+    return track(inner->abandonAlarm(time));
+  }
+  kj::Promise<bool> test() override {
+    requireLive();
+    return track(inner->test());
+  }
+  kj::Promise<CustomEvent::Result> customEvent(kj::Own<CustomEvent> event) override {
+    if (budget->exceeded()) {
+      auto e = memoryBudgetException();
+      event->failed(e);
+      return kj::mv(e);
+    }
+    // RPC can export capabilities that outlive this entrypoint and retain its IoContext.
+    // Until this budget integrates their lifetime, do not admit custom events in memory-limited mode.
+    return event->notSupported().attach(kj::mv(event));
+  }
+
+ private:
+  template <typename T>
+  kj::Promise<T> track(kj::Promise<T> promise) {
+    budget->beginRequest();
+    return budget->canceler.wrap(kj::mv(promise)).attach(kj::defer([state = kj::addRef(*budget)]() mutable {
+      state->endRequest();
+    }));
+  }
+
+  class ResponseTracker final: public Response {
+   public:
+    ResponseTracker(Response& inner, ExperimentalMemoryBudget& budget)
+        : inner(inner),
+          budget(budget) {}
+    kj::Own<kj::AsyncOutputStream> send(uint status,
+        kj::StringPtr text,
+        const kj::HttpHeaders& headers,
+        kj::Maybe<uint64_t> size) override {
+      budget.beforeResponse();
+      if (budget.exceeded()) kj::throwFatalException(memoryBudgetException());
+      sent = true;
+      return inner.send(status, text, headers, size);
+    }
+    kj::Own<kj::WebSocket> acceptWebSocket(const kj::HttpHeaders& headers) override {
+      budget.beforeResponse();
+      if (budget.exceeded()) kj::throwFatalException(memoryBudgetException());
+      budget.hasConnection();
+      sent = true;
+      return inner.acceptWebSocket(headers);
+    }
+    bool sent = false;
+
+   private:
+    Response& inner;
+    ExperimentalMemoryBudget& budget;
+  };
+  void requireLive() {
+    if (budget->isRetiring()) kj::throwFatalException(memoryBudgetException());
+  }
+  kj::Own<ExperimentalMemoryBudget> budget;
+  kj::Own<WorkerInterface> inner;
+  const kj::HttpHeaderTable& headerTable;
+};
+
+inline kj::Own<WorkerInterface> wrapExperimentalMemoryInterface(kj::Own<WorkerInterface> inner,
+    ExperimentalMemoryBudget& budget,
+    const kj::HttpHeaderTable& headerTable) {
+  if (!budget.enabled()) return inner;
+  return kj::heap<MemoryLimitedWorkerInterface>(
+      newRevocableWebSocketWorkerInterface(kj::mv(inner), budget.onStopped()), kj::addRef(budget),
+      headerTable);
+}
+
+}  // namespace workerd::server
