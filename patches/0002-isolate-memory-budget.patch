+
+kj::Promise<void> worker_memory_retire(const CompiledWorker& worker) {
+  auto impl = kj::addRef(worker.getImpl());
+  auto& memory = *impl->memory;
+  co_await memory.onRetired();
+  if (!memory.exceeded()) {
+    auto drained = memory.onIdle().then([impl = kj::addRef(*impl)]() {
+      return impl->waitUntilTasks.onEmpty();
+    });
+    co_await drained
+        .exclusiveJoin(impl->factory.getImpl().threadContext.getUnsafeTimer().afterDelay(
+            memory.remainingGrace()))
+        .exclusiveJoin(memory.onStopped().catch_([](kj::Exception&&) {}));
+  }
+  memory.revokeAll();
+  worker_unlink(worker);
+  impl->worker = kj::none;
+}
