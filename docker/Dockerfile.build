FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    clang-19 libc++-19-dev libc++abi-19-dev lld-19 clang-format-19 \
    python3 tcl git curl ca-certificates xz-utils unzip patch pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fL https://releases.bazel.build/9.3.1/release/bazel-9.3.1-linux-x86_64 \
    -o /usr/local/bin/bazel \
    && echo '7f775b54bbec487efaf0f49ccda1d2ed02cd34f582edfdd6aeeec76e39ef585c  /usr/local/bin/bazel' | sha256sum -c - \
    && chmod +x /usr/local/bin/bazel \
    && ln -s /usr/bin/clang-19 /usr/local/bin/clang
WORKDIR /work
