FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    clang-19 libc++-19-dev libc++abi-19-dev lld-19 clang-format-19 \
    python3 tcl git curl ca-certificates xz-utils unzip patch pkg-config \
    && rm -rf /var/lib/apt/lists/*
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      amd64) bazel_arch=x86_64; bazel_sha=7668a95db1250f12c40407251e4e203b4ec8bf39bc495d2f485b2d8c99048694 ;; \
      arm64) bazel_arch=arm64; bazel_sha=049dd21f40ad979db11c3ee68c96a42ce75f1185e69ac61ab20de1501427a410 ;; \
      *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && curl -fL "https://releases.bazel.build/9.2.0/release/bazel-9.2.0-linux-${bazel_arch}" \
    -o /usr/local/bin/bazel \
    && echo "${bazel_sha}  /usr/local/bin/bazel" | sha256sum -c - \
    && chmod +x /usr/local/bin/bazel \
    && ln -s /usr/bin/clang-19 /usr/local/bin/clang
WORKDIR /work
